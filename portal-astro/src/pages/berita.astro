---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import QuickChatbot from "../components/svelte/QuickChatbot.svelte";
import { fetchNewsList } from "../lib/api";
import { getImageUrl } from "../lib/cloudinary";

const newsList = await fetchNewsList("", "");
---

<Layout
  title="Newsroom: SMK Telkom Sidoarjo"
  description="Kumpulan berita resmi, dokumentasi kegiatan kejuruan, dan kabar prestasi civitas akademika SMK Telkom Sidoarjo."
>
  <Navbar slot="navbar" />

  <!-- Hero Header -->
  <section class="py-20 bg-black border-b border-white/10 apple-radial-glow">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center">
      <span class="text-xs uppercase tracking-widest text-[#86868b] font-medium">Newsroom SKOMDA</span>
      <h1 class="text-4xl sm:text-6xl font-semibold text-[#f5f5f7] tracking-tight mt-3">
        Kabar & Prestasi Terbaru.
      </h1>
      <p class="text-base sm:text-lg text-[#86868b] mt-4 max-w-xl mx-auto leading-relaxed">
        Pembaruan resmi seputar inovasi pembelajaran, kompetisi kejuruan tingkat nasional, dan agenda sekolah.
      </p>
    </div>
  </section>

  <!-- News Grid -->
  <section class="py-20 max-w-6xl mx-auto px-4 sm:px-6 apple-deferred-section">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {newsList.map((item) => (
        <article id={item.slug} class="bg-[#161617] rounded-3xl border border-white/10 overflow-hidden flex flex-col hover:border-white/20 transition-all duration-300 group">
          <div class="aspect-16/9 bg-black overflow-hidden relative">
            <img
              src={getImageUrl(item.image, { width: 640, height: 360, crop: "fill", quality: "auto" })}
              alt={item.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-apple"
              loading="lazy"
            />
            <span class="absolute top-3 left-3 px-3 py-1 rounded-full text-[10px] font-medium bg-black/80 backdrop-blur-md text-[#f5f5f7] border border-white/10">
              {item.category}
            </span>
          </div>

          <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
            <div>
              <div class="text-[11px] font-mono text-[#86868b] mb-1.5">
                {item.dateFormatted} &bull; {item.time} WIB
              </div>

              <h2 class="text-base sm:text-lg font-semibold text-[#f5f5f7] leading-snug">
                {item.title}
              </h2>

              <p class="text-xs sm:text-sm text-[#86868b] mt-3 line-clamp-3 leading-relaxed">
                {item.summary}
              </p>
            </div>

            <div class="pt-4 border-t border-white/5 flex items-center justify-between text-xs">
              <span class="text-[#86868b] text-[11px] font-mono">{item.author}</span>
              <span class="text-[#E1251B] font-medium">Dokumentasi Resmi</span>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <Footer slot="footer" />
  <QuickChatbot client:idle slot="widgets" />
</Layout>
