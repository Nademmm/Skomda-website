---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import QuickChatbot from "../components/svelte/QuickChatbot.svelte";
import { fetchJurusanList } from "../lib/api";

const jurusans = await fetchJurusanList();
---

<Layout
  title="Program Keahlian: SMK Telkom Sidoarjo"
  description="Detail kurikulum program keahlian vokasi unggulan SMK Telkom Sidoarjo: SIJA 4 Tahun dan TJAT 3 Tahun dengan sertifikasi industri internasional."
>
  <Navbar slot="navbar" />

  <!-- Hero Header -->
  <section class="py-20 bg-black border-b border-white/10 apple-radial-glow">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center">
      <span class="text-xs uppercase tracking-widest text-[#86868b] font-medium">Spesifikasi Akademik</span>
      <h1 class="text-4xl sm:text-6xl font-semibold text-[#f5f5f7] tracking-tight mt-3">
        Dua Jalur Keahlian Vokasi.
      </h1>
      <p class="text-base sm:text-lg text-[#86868b] mt-4 max-w-2xl mx-auto leading-relaxed">
        Kurikulum yang dirancang bersama industri telekomunikasi dan komputasi awan terkemuka, membekali siswa dengan kompetensi siap kerja.
      </p>
    </div>
  </section>

  <!-- Jurusan Cards Grid (Apple Product Showcase) -->
  <section class="py-20 max-w-5xl mx-auto px-4 sm:px-6 space-y-16 apple-deferred-section">
    {jurusans.map((j) => (
      <div id={j.slug} class="bg-[#161617] rounded-3xl border border-white/10 p-8 sm:p-12 shadow-2xl space-y-8 hover:border-white/20 transition-all duration-300">
        <div class="flex flex-wrap items-center justify-between gap-4 border-b border-white/10 pb-6">
          <div>
            <div class="flex items-center gap-3">
              <span class="px-3.5 py-1 rounded-full text-xs font-semibold bg-[#E1251B] text-white">
                {j.code}
              </span>
              <span class="text-xs font-mono text-[#86868b]">
                {j.years} Tahun Pembelajaran
              </span>
            </div>
            <h2 class="text-2xl sm:text-4xl font-semibold text-[#f5f5f7] mt-3 tracking-tight">
              {j.name}
            </h2>
          </div>
          <span class="text-xs font-mono px-3.5 py-1.5 rounded-full bg-white/5 text-[#f5f5f7] border border-white/10">
            Akreditasi A BAN-SM
          </span>
        </div>

        <p class="text-base sm:text-lg text-[#86868b] leading-relaxed">
          {j.description}
        </p>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="p-6 rounded-2xl bg-black/60 border border-white/5 space-y-2">
            <h3 class="text-xs uppercase tracking-widest text-[#E1251B] font-semibold">
              Fokus Kompetensi Inti
            </h3>
            <p class="text-sm font-medium text-[#f5f5f7] leading-relaxed">
              {j.focus}
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-black/60 border border-white/5 space-y-2">
            <h3 class="text-xs uppercase tracking-widest text-[#86868b] font-semibold">
              Prospek Profesi Industri
            </h3>
            <p class="text-sm font-medium text-[#f5f5f7] leading-relaxed">
              {j.careerProspects}
            </p>
          </div>
        </div>

        <div class="pt-4 flex flex-wrap items-center gap-4">
          <a
            href="https://ppdb.smktelkom-sda.sch.id"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 rounded-full bg-[#E1251B] hover:bg-[#ff3b30] text-white text-xs font-medium tracking-tight transition"
          >
            Daftar Jurusan Ini di PPDB
          </a>
          <a
            href="/"
            class="px-6 py-3 rounded-full bg-white/5 hover:bg-white/10 text-[#f5f5f7] text-xs font-medium border border-white/10 transition"
          >
            Kembali ke Beranda
          </a>
        </div>
      </div>
    ))}
  </section>

  <Footer slot="footer" />
  <QuickChatbot client:idle slot="widgets" />
</Layout>
