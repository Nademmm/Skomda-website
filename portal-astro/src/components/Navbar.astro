---
const currentPath = Astro.url.pathname;

const navItems = [
  { name: "Beranda", href: "/" },
  { name: "Program Keahlian", href: "/jurusan" },
  { name: "Berita", href: "/berita" },
  { name: "Kurikulum Industri", href: "#kurikulum" },
  { name: "Kontak", href: "#kontak" },
];
---

<header class="sticky top-0 z-50 w-full apple-blur border-b border-white/10 transition-all duration-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 h-12 flex items-center justify-between">
    <!-- Brand Logo (Apple-style minimal badge) -->
    <a
      href="/"
      class="flex items-center gap-2.5 text-white focus:outline-none focus:ring-1 focus:ring-red-500 rounded-md py-1"
      aria-label="Beranda SMK Telkom Sidoarjo"
    >
      <div class="w-6 h-6 rounded-md bg-[#E1251B] flex items-center justify-center font-black text-xs text-white shadow-xs">
        SK
      </div>
      <span class="text-xs font-semibold tracking-tight text-[#f5f5f7]">
        SMK Telkom Sidoarjo
      </span>
    </a>

    <!-- Desktop Minimalist Nav Links -->
    <nav class="hidden md:flex items-center space-x-7">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            class:list={[
              "text-xs transition-colors duration-200 tracking-normal py-2 flex items-center min-h-[44px]",
              isActive
                ? "text-white font-medium border-b border-[#E1251B]"
                : "text-[#86868b] hover:text-[#f5f5f7]"
            ]}
          >
            {item.name}
          </a>
        );
      })}
    </nav>

    <!-- Right Action Button (Apple Pill style) -->
    <div class="hidden md:flex items-center gap-3">
      <a
        href="https://ppdb.smktelkom-sda.sch.id"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center px-3.5 py-1.5 rounded-full bg-[#E1251B] hover:bg-[#ff3b30] text-white text-xs font-medium tracking-tight transition shadow-sm min-h-[32px]"
      >
        Daftar PPDB
      </a>
    </div>

    <!-- Mobile Menu Button -->
    <button
      id="apple-menu-btn"
      class="md:hidden p-2 text-[#86868b] hover:text-white focus:outline-none min-w-[44px] min-h-[44px] flex items-center justify-center"
      aria-label="Buka Menu"
      aria-expanded="false"
    >
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </div>

  <!-- Mobile Menu Dropdown (Apple Fullscreen/Translucent overlay) -->
  <div id="apple-mobile-menu" class="hidden md:hidden bg-black/95 border-b border-white/10 px-6 py-6 space-y-4">
    {navItems.map((item) => (
      <a
        href={item.href}
        class="block text-sm font-normal text-[#86868b] hover:text-[#f5f5f7] py-2 border-b border-white/5 transition"
      >
        {item.name}
      </a>
    ))}
    <div class="pt-2">
      <a
        href="https://ppdb.smktelkom-sda.sch.id"
        target="_blank"
        rel="noopener noreferrer"
        class="block w-full text-center py-2.5 rounded-full bg-[#E1251B] text-white text-xs font-semibold"
      >
        Daftar PPDB Online
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById("apple-menu-btn");
  const menu = document.getElementById("apple-mobile-menu");

  if (btn && menu) {
    btn.addEventListener("click", () => {
      const isHidden = menu.classList.toggle("hidden");
      btn.setAttribute("aria-expanded", String(!isHidden));
    });
  }
</script>
