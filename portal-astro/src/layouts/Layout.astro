---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "SMK Telkom Sidoarjo: Pendidikan Vokasi Berbasis Teknologi dan Industri",
  description = "Portal resmi SMK Telkom Sidoarjo. Eksplorasi keunggulan kurikulum vokasi SIJA 4 Tahun dan TJAT 3 Tahun dengan arsitektur render performa tinggi.",
} = Astro.props;
---

<!doctype html>
<html lang="id" class="scroll-smooth bg-black text-[#f5f5f7]">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Preconnect ke Cloudinary CDN untuk mempercepat First Contentful Paint -->
    <link rel="preconnect" href="https://res.cloudinary.com" crossorigin />
    <link rel="dns-prefetch" href="https://res.cloudinary.com" />

    <style is:global>
      /* Apple-style smooth typography rendering */
      body {
        font-feature-settings: "cv02", "cv03", "cv04", "cv11";
        text-rendering: optimizeLegibility;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        background-color: #000000;
        color: #f5f5f7;
      }

      /* Apple Signature Backdrop Filter */
      .apple-blur {
        background: rgba(0, 0, 0, 0.8);
        backdrop-filter: blur(20px) saturate(180%);
        -webkit-backdrop-filter: blur(20px) saturate(180%);
      }

      /* Defer rendering for below-the-fold content (content-visibility pattern) */
      .apple-deferred-section {
        content-visibility: auto;
        contain-intrinsic-size: auto none auto 700px;
      }

      /* Apple Minimalist Scrollbar */
      ::-webkit-scrollbar {
        width: 8px;
        height: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #000000;
      }
      ::-webkit-scrollbar-thumb {
        background: #2c2c2e;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #3a3a3c;
      }

      /* Subtle Apple radial glow */
      .apple-radial-glow {
        background: radial-gradient(circle at 50% 0%, rgba(225, 37, 27, 0.18) 0%, rgba(0, 0, 0, 0) 65%);
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col selection:bg-[#E1251B] selection:text-white overflow-x-hidden">
    <slot name="navbar" />
    <main class="flex-1">
      <slot />
    </main>
    <slot name="footer" />
    <slot name="widgets" />
  </body>
</html>
